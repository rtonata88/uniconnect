APP_NAME=UniConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of the gateway (Traefik). The web app, API and WebSockets share this origin.
APP_URL=https://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Host / ports (read by ecosystem.config.cjs, the Makefile and the scripts)
# ---------------------------------------------------------------------------
# Address other services use to reach instances started on THIS machine (LAN IP for multi-machine).
APP_ADVERTISE_HOST=127.0.0.1
# PHP binary used for every artisan/octane process (e.g. php84 under Laravel Herd).
PHP_BIN=php
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
GATEWAY_DASHBOARD_PORT=8090
# Plain-HTTP entrypoint for server-to-server traffic (API -> Reverb HTTP API)
GATEWAY_INTERNAL_PORT=8092
GATEWAY_INTERNAL_BIND=127.0.0.1
API_BASE_PORT=8001
REVERB_BASE_PORT=8101
API_INSTANCES=2
REVERB_INSTANCES=2
WEB_PORT=5173
# Extra hostnames/IPs for the mkcert certificate (space separated), e.g. your LAN IP for phones.
CERT_EXTRA_HOSTS=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# MySQL 8.4: primary (writes) + replica (reads), GTID replication
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_REPLICA_HOST=127.0.0.1
DB_REPLICA_PORT=3307
DB_DATABASE=uniconnect
DB_USERNAME=uniconnect
DB_PASSWORD=uniconnect-secret
DB_REPLICATION_PASSWORD=repl-secret
# 0.0.0.0 to let API instances on other machines connect
DB_BIND_ADDRESS=127.0.0.1
# Directory holding mysqld/mysql 8.4 binaries (empty = use PATH)
MYSQL_BIN_DIR=

SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Database used for the service registry and Traefik KV (keys are not prefixed)
REDIS_REGISTRY_DB=0

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@uniconnect.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# MinIO (S3 compatible), private bucket, signed URLs
# ---------------------------------------------------------------------------
# Directory holding minio/mc binaries (empty = use PATH). See scripts/build-minio-from-source.sh
MINIO_BIN_DIR=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=uniconnect
AWS_SECRET_ACCESS_KEY=uniconnect-minio-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=uc-private
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---------------------------------------------------------------------------
# Reverb (WebSockets). Clients connect through the gateway (/app). The API
# publishes through the gateway's internal entrypoint, which balances across instances.
# ---------------------------------------------------------------------------
REVERB_APP_ID=uniconnect
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8092
REVERB_SCHEME=http
REVERB_SCALING_ENABLED=true
REVERB_SCALING_CHANNEL=uniconnect-reverb

# Web Push (generated by `php artisan webpush:vapid`)
VAPID_SUBJECT=mailto:admin@uniconnect.test
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Proxies allowed to set X-Forwarded-* (the Traefik host). Add its LAN IP for multi-machine.
TRUSTED_PROXIES=127.0.0.1,::1
# Comma separated origins allowed by CORS (defaults to APP_URL)
CORS_ALLOWED_ORIGINS=
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080
