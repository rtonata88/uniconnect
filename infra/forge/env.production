# UniConnect on Laravel Forge: paste into Site → Environment (this is backend/.env).
# Replace every value in <angle brackets>. Keys left out fall back to backend/.env.example.
# After saving, generate the secrets once over SSH (see docs/forge.md, step 5).

APP_NAME=UniConnect
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<your-domain>

# Forge's PHP 8.4 CLI binary (the run-*.sh scripts and the Makefile use it)
PHP_BIN=php8.4
APP_ADVERTISE_HOST=127.0.0.1

# one API (Octane) and one Reverb instance behind Nginx; ports must match infra/forge/nginx-locations.conf
API_BASE_PORT=8001
API_INSTANCES=1
API_WORKERS=4
REVERB_BASE_PORT=8101
REVERB_INSTANCES=1

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Forge's MySQL: one server, so reads go to the primary as well
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_REPLICA_HOST=127.0.0.1
DB_REPLICA_PORT=3306
DB_DATABASE=<forge-database-name>
DB_USERNAME=<forge-database-user>
DB_PASSWORD=<forge-database-password>

SESSION_DRIVER=array
BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Forge's Redis (bound to localhost, no password by default)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_REGISTRY_DB=0

# files on this server's disk: backend/storage/app/private, served by signed /api/files/... URLs
FILESYSTEM_DISK=local

# the app publishes broadcasts straight to the local Reverb instance
REVERB_APP_ID=uniconnect
REVERB_APP_KEY=<random, e.g. openssl rand -hex 10>
REVERB_APP_SECRET=<random, e.g. openssl rand -hex 20>
REVERB_HOST=127.0.0.1
REVERB_PORT=8101
REVERB_SCHEME=http
REVERB_SCALING_ENABLED=true
REVERB_SCALING_CHANNEL=uniconnect-reverb

# Web Push: filled in by `php8.4 artisan webpush:vapid` (step 5)
VAPID_SUBJECT=mailto:<you@example.com>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# password-reset e-mails; use your provider (Mailgun, Postmark, SES, SMTP...)
MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS="no-reply@<your-domain>"
MAIL_FROM_NAME="${APP_NAME}"

# Nginx on the same machine is the only proxy
TRUSTED_PROXIES=127.0.0.1,::1
# public IPs allowed to open /horizon (yours), comma-separated
HORIZON_ALLOWED_IPS=127.0.0.1,::1,<your-ip>
CORS_ALLOWED_ORIGINS=
